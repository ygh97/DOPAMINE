{
  "name": "dopamine-center",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev --workspace @dopamine/server & npm run dev --workspace @dopamine/web",
    "dev:server": "npm run dev --workspace @dopamine/server",
    "dev:web": "npm run dev --workspace @dopamine/web",
    "test": "npm test --workspace @dopamine/engine && npm test --workspace @dopamine/server",
    "typecheck": "tsc -p packages/engine && tsc -p apps/server && npm run typecheck --workspace @dopamine/web",
    "build": "npm run build --workspace @dopamine/web",
    "sim": "node tools/sim-week.ts 1 2 3",
    "sim:quick": "node tools/sim-week.ts 1 2 3 --days 1",
    "e2e": "node tools/e2e-m1.cjs",
    "e2e:quick": "node tools/e2e-m1.cjs --quick",
    "check": "npm test && npm run typecheck && npm run sim:quick && npm run e2e:quick && npm run e2e:split && npm run e2e:m2 && npm run e2e:season && npm run e2e:m4 && npm run e2e:m5 && npm run e2e:m6 && npm run e2e:m7",
    "e2e:split": "node tools/e2e-split.cjs",
    "e2e:m2": "node tools/e2e-m2.cjs",
    "e2e:season": "node tools/e2e-season.cjs",
    "e2e:m4": "node tools/e2e-m4.cjs",
    "e2e:m5": "node tools/e2e-m5.cjs",
    "e2e:m6": "node tools/e2e-m6.cjs",
    "e2e:m7": "node tools/e2e-m7.cjs",
    "loadtest": "node --disable-warning=ExperimentalWarning tools/load-test.ts",
    "dev:test": "node tools/dev-test.mjs",
    "sim:bots": "node --disable-warning=ExperimentalWarning tools/sim-bots.ts 1 2 3 4 5 6"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "~6.0.3"
  }
}
